<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Create Account — AUTHENTIX</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<header class="site-header">
  <div class="header-inner">
    <a href="index.html"><img src="images/YOUR-LOGO.png" class="logo"></a>
    <h1 class="site-title">Create Account</h1>
  </div>
</header>

<main style="max-width:520px;margin:40px auto;padding:0 16px;">
  <form id="accountForm" class="account-form">
    <label>Full name</label>
    <input type="text" id="acctName" style="padding:10px;border-radius:8px;border:1px solid #dfe7f8;width:100%">
    <label style="margin-top:12px">Email</label>
    <input type="email" id="acctEmail" style="padding:10px;border-radius:8px;border:1px solid #dfe7f8;width:100%">
    <label style="margin-top:12px">Password</label>
    <input type="password" id="acctPass" style="padding:10px;border-radius:8px;border:1px solid #dfe7f8;width:100%">
    <button type="submit" style="margin-top:18px;padding:12px 18px;background:var(--blue);color:white;border:none;border-radius:8px;font-weight:700">Create Account</button>
  </form>
</main>

<footer class="site-footer"><nav class="footer-nav"><a href="index.html">Home</a></nav></footer>

<script>
document.getElementById('accountForm').addEventListener('submit', (e)=>{
  e.preventDefault();
  alert('Account creation demo only — integrate backend to save users.');
});
</script>
</body>
</html>
